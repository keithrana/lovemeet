generator client {
  provider      = "prisma-client-js"
  // "native" builds for local dev; "rhel-openssl-3.0.x" is the engine
  // Vercel's serverless functions actually run on. Without both, database
  // calls crash in production with no useful error message.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  age          Int
  bio          String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
